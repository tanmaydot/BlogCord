---
import { SITE } from '../site.config';
import { slugify, url } from '../lib';
interface Props { tags: [string, number][]; total: number }
const { tags, total } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const item = (active: boolean) =>
  `group flex items-center gap-2 rounded px-2 py-1.5 text-[15px] ${active ? 'bg-elev text-strong' : 'text-muted hover:bg-elev/60 hover:text-body'}`;
const ctl = 'grid h-8 w-8 place-items-center rounded text-muted hover:bg-elev hover:text-strong';
---

<aside aria-label="Channels" class="flex min-h-0 w-60 shrink-0 flex-col bg-side max-md:flex-1">
  <div class="flex h-12 items-center border-b border-line px-4 font-semibold text-strong shadow-sm">{SITE.title}</div>
  <nav class="scroll flex-1 px-2 py-3">
    <p class="px-2 pb-1 text-xs font-semibold uppercase tracking-wide text-muted">Channels</p>
    <a href={url('/')} class={item(path === url('/').replace(/\/$/, '') || path === '/')} aria-current={path === '/' ? 'page' : undefined}>
      <span class="text-lg leading-none text-muted">#</span> all-posts
      <span class="ml-auto text-xs text-muted">{total}</span>
    </a>
    {tags.map(([tag, n]) => {
      const href = url(`/tags/${slugify(tag)}/`);
      const active = path === href.replace(/\/$/, '');
      return (
        <a href={href} class={item(active)} aria-current={active ? 'page' : undefined}>
          <span class="text-lg leading-none text-muted">#</span> {slugify(tag)}
          <span class="ml-auto text-xs text-muted">{n}</span>
        </a>
      );
    })}
    <a href="/rss.xml" class={`${item(false)} mt-3`}>
      <span class="text-lg leading-none text-muted">📡</span> rss
    </a>
  </nav>
  <div class="flex items-center gap-2 bg-rail/60 p-2">
    <div class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent text-sm font-bold text-white">{SITE.author.initial}</div>
    <div class="min-w-0 flex-1 truncate text-sm font-medium text-strong">{SITE.author.name}</div>
    <button type="button" class={ctl} data-action="open-search" aria-label="Search (Ctrl+K)" title="Search (Ctrl+K)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </button>
    <button type="button" class={ctl} data-action="cycle-theme" aria-label="Switch theme (dark, light, AMOLED)" title="Switch theme">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</aside>
